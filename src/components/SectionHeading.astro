---
import { site } from '../config/site';

interface Props {
  /** Section id, matching an entry in site.nav (e.g. "about"). */
  id: string;
}

const { id } = Astro.props;
const index = site.nav.findIndex((item) => item.href === `/#${id}`);
if (index === -1) throw new Error(`SectionHeading: no entry in site.nav for "#${id}".`);

const number = String(index + 1).padStart(2, '0');
---

<h2 id={`${id}-title`} class="section-heading">
  <span class="tag" aria-hidden="true">
    {number}
  </span>
  <span>{site.nav[index].heading}</span>
</h2>

<style>
  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 0.875rem;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
  }
</style>
