---
import { typeLabels, type Project } from '../lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, type, stack } = project.data;
---

<li class="card">
  <p class="tag">{typeLabels[type]}</p>
  <h3 class="mt-2 text-xl">
    <a href={`/projects/${project.id}`} class="card-link">
      {title}
    </a>
  </h3>
  <p class="mt-3 text-muted">{summary}</p>
  <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1" aria-label="Technologies">
    {stack.slice(0, 4).map((item) => (
      <li class="tag">{item}</li>
    ))}
  </ul>
  <p class="mt-5 font-semibold" aria-hidden="true">
    Read case study →
  </p>
</li>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    list-style: none;
  }
  .card-link {
    color: var(--text);
    text-decoration: none;
  }
  /* One tab stop and a large click target for the whole card. */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
  }
  .card-link:focus-visible {
    outline: none;
  }
  .card:has(.card-link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .card > p:last-child {
    margin-top: auto;
    padding-top: 1.25rem;
    color: var(--accent);
  }
</style>
