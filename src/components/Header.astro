---
import { site } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header" data-header>
  <div class="container-content bar">
    <a href="/" class="brand">
      {site.name}
    </a>

    <div class="actions">
      <button
        type="button"
        class="nav-toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        Menu
      </button>
      <ThemeToggle />
    </div>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul>
        {site.nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.75rem;
  }
  .brand {
    /* On phones the name may wrap so the menu and theme buttons stay on the same row. */
    flex: 1 1 0;
    min-width: 0;
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    order: 2;
  }
  .nav {
    order: 3;
    width: 100%;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    display: inline-block;
    padding-block: 0.25rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .nav a:hover {
    color: var(--accent);
  }

  .nav-toggle {
    display: none;
    height: 2.5rem;
    padding-inline: 0.875rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }
  .nav-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Small screens with JS: collapse links behind the menu button. */
  @media (max-width: 767px) {
    :global(html.js) .nav-toggle {
      display: inline-flex;
      align-items: center;
    }
    :global(html.js) .nav {
      display: none;
    }
    :global(html.js) [data-header][data-open='true'] .nav {
      display: block;
    }
    :global(html.js) ul {
      flex-direction: column;
      padding-bottom: 0.5rem;
    }
  }

  @media (min-width: 768px) {
    .brand {
      flex: 0 0 auto;
    }
    .nav {
      order: 2;
      width: auto;
      margin-left: auto;
    }
    .actions {
      order: 3;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');

  const setOpen = (open: boolean) => {
    header?.setAttribute('data-open', String(open));
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Close the menu after choosing a link, or with Escape.
  header
    ?.querySelectorAll('nav a')
    .forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
