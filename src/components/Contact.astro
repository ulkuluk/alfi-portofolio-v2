---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { site } from '../config/site';
import SectionHeading from './SectionHeading.astro';

const { blurb, email, linkedin, github, resume, now } = site.contact;
// The resume button only shows when the file is actually in /public.
const hasResume = existsSync(join(process.cwd(), 'public', resume));
---

<section id="contact" class="section border-t border-border" aria-labelledby="contact-title">
  <div class="container-content">
    <SectionHeading id="contact" />
    <p class="measure mt-8 text-lg">{blurb}</p>

    <p class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href={`mailto:${email}`}>
        Email me
      </a>
      <a class="btn" href={linkedin} rel="noopener">
        LinkedIn
      </a>
      <a class="btn" href={github} rel="noopener">
        GitHub
      </a>
      {hasResume && (
        <a class="btn" href={resume}>
          Résumé (PDF)
        </a>
      )}
    </p>

    <p class="tag mt-6">
      {email} · {site.location}
    </p>

    {now && (
      <p class="measure mt-10 border-t border-border pt-6">
        <span class="tag">Now</span> {now}
      </p>
    )}
  </div>
</section>
