---
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border py-10 text-sm text-muted">
  <div class="container-content flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <p>
      © {year} {site.name}
    </p>
    <ul role="list" class="flex flex-wrap gap-x-2">
      <li>
        Built with <a href="https://astro.build">Astro</a>
      </li>
      <li aria-hidden="true">·</li>
      <li>
        <a href={site.repo}>Source</a>
      </li>
      <li aria-hidden="true">·</li>
      <li>
        <a href="/colophon">Colophon</a>
      </li>
    </ul>
  </div>
</footer>

<style>
  /* Comfortable tap target for the small footer links. */
  li a {
    display: inline-block;
    padding-block: 0.375rem;
  }
</style>
