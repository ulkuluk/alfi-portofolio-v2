---
import { site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border py-10 text-sm text-muted">
  <div class="container-content flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <p>
      © {year} {site.name}
    </p>
    <p>
      Built with <a href="https://astro.build">Astro</a> ·<a href={site.repo}>Source</a> ·
      <a href="/colophon">Colophon</a>
    </p>
  </div>
</footer>
