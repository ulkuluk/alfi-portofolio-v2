---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="section">
    <div class="container-content measure">
      <p class="tag">404</p>
      <h1 class="mt-2 text-4xl">That page doesn't exist.</h1>
      <p class="mt-4 text-muted">The link may be old, or I may have moved things around.</p>
      <p class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/">
          Back to the home page
        </a>
        <a class="btn" href="/#projects">
          See my projects
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
