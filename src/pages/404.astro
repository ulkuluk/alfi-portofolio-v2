---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="section">
    <div class="container-content measure">
      <h1 class="text-4xl">That page doesn't exist.</h1>
      <p class="mt-4 text-muted">The link may be old, or I may have moved things around.</p>
      <p class="mt-8">
        <a class="btn" href="/">
          Back to the home page
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
