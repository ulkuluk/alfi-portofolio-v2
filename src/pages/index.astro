---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import About from '../components/About.astro';
import ExperienceList from '../components/ExperienceList.astro';
import Skills from '../components/Skills.astro';
import LearningJourney from '../components/LearningJourney.astro';
import Contact from '../components/Contact.astro';
import { site } from '../config/site';
import { getProjects } from '../lib/projects';

const projects = (await getProjects()).filter((project) => project.data.featured);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  url: Astro.site?.href ?? site.url,
  email: `mailto:${site.contact.email}`,
  worksFor: { '@type': 'Organization', name: site.employer },
  alumniOf: { '@type': 'CollegeOrUniversity', name: site.alumniOf },
  sameAs: [site.contact.github, site.contact.linkedin],
};
---

<BaseLayout jsonLd={person}>
  <Hero />

  <section id="projects" class="section border-t border-border" aria-labelledby="projects-title">
    <div class="container-content">
      <SectionHeading id="projects" />
      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </ul>
    </div>
  </section>

  <About />
  <ExperienceList />
  <Skills />
  <LearningJourney />
  <Contact />
</BaseLayout>
