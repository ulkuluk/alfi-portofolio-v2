---
import '../styles/global.css';
import { site } from '../config/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (used by the 404 page). */
  noindex?: boolean;
  /** Structured data to embed as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.description, noindex = false, jsonLd } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.title}`;

const base = Astro.site ?? new URL(site.url);
// Pages are built as name.html but served without the extension, like the sitemap lists them.
const path = Astro.url.pathname.replace(/(^|\/)index\.html$/, '$1').replace(/\.html$/, '');
const canonical = new URL(path || '/', base).href;
const image = new URL(site.ogImage, base).href;
const imageAlt = `${site.name}, ${site.role}`;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={jsonLd ? 'profile' : 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only-focusable skip-link">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="fade-in">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: 1rem;
    z-index: 50;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 600;
    text-decoration: none;
  }
</style>
